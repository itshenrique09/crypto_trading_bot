# ── Crypto Trading Bot — environment template ─────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Only APP_PASSWORD is strictly required (production).
# Exchange API keys are NOT env vars — they are entered at runtime in
# Settings and stored AES-256 encrypted in SQLite (bot_settings table).

# ── Core ──────────────────────────────────────────────────────────────
# HTTP basic-auth password that gates the dashboard (required in prod;
# dev skips auth entirely). Also the KDF input for the AES-256 key that
# encrypts exchange API keys at rest — CHANGING IT MAKES PREVIOUSLY
# STORED EXCHANGE KEYS UNREADABLE (re-enter them in Settings after).
APP_PASSWORD=change-me

# development | production
NODE_ENV=development

# HTTP port the Express server binds to (default 5000).
# Pick another port if 5000 is taken on your machine.
PORT=5000

# ── Build metadata (optional — shown at /api/runtime and /api/health) ─
# Typically injected by the deploy pipeline, not set by hand.
# APP_VERSION=
# BUILD_COMMIT=
# BUILD_TIME=
# BUILD_DIRTY=
