# ── Crypto Trading Bot — environment template ─────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Only APP_PASSWORD is strictly required for production.
# MEXC keys can alternatively be set via POST /api/live/config (stored
# encrypted in SQLite using APP_PASSWORD as the KDF input).

# ── Core ──────────────────────────────────────────────────────────────
# HTTP basic-auth password that gates the dashboard (required in prod).
# Also used to derive the AES-256 key that encrypts MEXC keys at rest,
# so changing it will render any previously-stored MEXC keys unreadable.
APP_PASSWORD=change-me

# development | production
NODE_ENV=development

# HTTP port the Express server binds to (default 5000).
PORT=5000

# ── MEXC Futures (live trading) ───────────────────────────────────────
# Optional — you can also configure these at runtime via the UI.
# If set here, they will NOT be persisted to the DB automatically;
# the /api/live/config endpoint is still what populates encrypted storage.
# MEXC_API_KEY=
# MEXC_API_SECRET=
