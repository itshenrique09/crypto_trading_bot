{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "description": "Up-to-date library docs (MEXC API, Binance, React Query, etc.)"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "description": "Browser automation for UI testing"
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@latest"],
      "env": {
        "FIRECRAWL_API_KEY": "REPLACE_WITH_YOUR_KEY"
      },
      "description": "Web scraping — crypto news, sentiment, market data"
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "REPLACE_WITH_YOUR_KEY"
      },
      "description": "Web search — strategy research, market conditions"
    },
    "taskmaster-ai": {
      "command": "npx",
      "args": ["-y", "--package=task-master-ai", "task-master-ai"],
      "env": {
        "ANTHROPIC_API_KEY": "REPLACE_WITH_YOUR_KEY"
      },
      "description": "AI task management for structured development"
    }
  }
}
